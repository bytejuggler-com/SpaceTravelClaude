{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 x64 (vcpkg, dev overlay + hot-reload)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "vs2022-dist",
      "displayName": "Distribution (no dev features, static runtime and libraries)",
      "inherits": "vs2022",
      "binaryDir": "${sourceDir}/build/dist",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "DEMO_DEV_MODE": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "vs2022", "configuration": "Debug" },
    { "name": "release", "configurePreset": "vs2022", "configuration": "RelWithDebInfo" },
    { "name": "dist", "configurePreset": "vs2022-dist", "configuration": "Release" }
  ]
}
